BRAINAPI_URL=http://localhost:8000
BRAINPAT_TOKEN=

# Search eval (default searchbenchsmoke). Must start with searchbench.
# SEARCH_BRAIN_ID=searchbenchsmoke

# Dual profile: product (greedy) | sota (Claude Haiku 5.5 + SC + gap-fill)
# BENCH_PROFILE=product
# BENCH_PROFILE=sota
# BENCH_SC_SAMPLES=5
# BENCH_SC_TEMPERATURE=0.7
# BENCH_GAP_FILL=1
# Optional overrides (default SOTA answerer is claude-haiku-5-5):
# BENCH_SOTA_ANSWER_MODEL=claude-haiku-5-5
# BENCH_SOTA_JUDGE_MODEL=claude-haiku-5-5

# Product chat LLMs default to Amazon Bedrock Haiku 5.5. Benchmark answer/judge
# still use an OpenAI-compatible HTTP client: optional direct Anthropic, or
# another OpenAI-compatible endpoint. Model id stays claude-haiku-5-5.
ANTHROPIC_API_KEY=
BENCH_LLM_BASE_URL=https://api.anthropic.com/v1
BENCH_ANSWER_MODEL=claude-haiku-5-5

# The judge must be a different model family from the answerer, or judge accuracy
# carries self-preference bias. Leave BENCH_JUDGE_MODEL unset to auto-select the
# Azure deployment below; set it explicitly to pin a judge.
# BENCH_JUDGE_MODEL=
# BENCH_JUDGE_BASE_URL=
# BENCH_JUDGE_API_KEY=

# Azure OpenAI judge (opt-in; set BENCH_JUDGE_AZURE_ENDPOINT + key, not auto-selected
# from repo-root AZURE_LARGE_LLM_ENDPOINT):
# BENCH_JUDGE_AZURE_ENDPOINT=
# BENCH_JUDGE_AZURE_KEY=
# BENCH_JUDGE_AZURE_API_VERSION=2024-12-01-preview

# Optional aliases if you prefer another OpenAI-compatible provider:
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# BENCH_LLM_BASE_URL=https://api.openai.com/v1
# BENCH_ANSWER_MODEL=gpt-4o-mini

# BEAM HF datasets (defaults):
# BENCH_BEAM_HF_DATASET=Mohammadta/BEAM
# BENCH_BEAM_HF_DATASET_10M=Mohammadta/BEAM-10M
