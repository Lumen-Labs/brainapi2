# --- Target BrainAPI (local docker stack or remote staging) ---
# Local default matches `make start-all` / `brainapi start`.
BRAINAPI_URL=http://localhost:8000
BRAINPAT_TOKEN=

# Aliases used by this harness (either name works):
# EVAL_BRAINAPI_URL=http://localhost:8000
# EVAL_API_KEY=

# Dedicated eval brains (alphanumeric). Never point these at locomo/beam/searchbench/demorecsys.
# EVAL_BRAIN_PREFIX=evaluc

# --- Shared LLM (plain config; no default chat model) ---
# One model id for the hybrid answerer and the LLM judge.
EVAL_LLM_API_KEY=
EVAL_LLM_PROVIDER=
EVAL_LLM_MODEL=
EVAL_LLM_BASE_URL=
# ANTHROPIC_API_KEY is also accepted as a chat-key fallback.

# Embeddings and the cross-encoder reranker are not chat LLMs (see below).
#
# Staging/real BrainAPI comparisons run ingest enrichment (graph extraction).
# Optional: fail preflight unless BrainAPI health/config report this chat model.
# EVAL_EXPECTED_BRAINAPI_MODEL=
# CI smoke keeps skip-enrichment and does not require this.

# --- Hybrid baseline embeddings / reranker ---
# Default strong baseline (no API key): BGE-large + BGE reranker-v2-m3.
# pip install -r evals/requirements-strong.txt
# EVAL_BASELINE_PROFILE=sota
# EVAL_EMBEDDING_PROVIDER=sentence-transformers
# EVAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# EVAL_RERANKER=cross-encoder
# EVAL_CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
#
# Cheaper documented option (not the external bar):
# EVAL_BASELINE_PROFILE=minilm
# EVAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EVAL_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#
# OpenAI-compatible dense embeddings (optional override):
# EVAL_EMBEDDING_PROVIDER=openai
# EVAL_EMBEDDING_API_KEY=
# EVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# EVAL_EMBEDDING_MODEL=text-embedding-3-large
#
# CI / ./evals.sh smoke forces hash + lexical regardless of these settings.

# --- Optional BrainAPI capability overrides ---
# EVAL_AS_OF_FIELD=as_of
# Native as-of field takes precedence when OpenAPI exposes it.
# If unset, as-of/changelog questions send include_history=true when OpenAPI has
# that flag. include_history is not a date filter.
# EVAL_CONFLICT_PATH=/retrieve/conflicts
# EVAL_CONFLICT_SCAN_PATH=/retrieve/conflicts/scan
# Sidecar-only: EVAL_CONFLICT_PATH=off and EVAL_CONFLICT_SCAN_PATH=off
# EVAL_CONFLICT_PLUGIN=temporal_conflicts

# --- Run layout ---
# EVAL_RUNS_DIR=evals/runs
# EVAL_SCALE=local/small-scale
