# --- Target BrainAPI (local docker stack or remote staging) ---
# Local default matches `make start-all` / `brainapi start`.
BRAINAPI_URL=http://localhost:8000
BRAINPAT_TOKEN=

# Aliases used by this harness (either name works):
# EVAL_BRAINAPI_URL=http://localhost:8000
# EVAL_API_KEY=

# Dedicated eval brains (alphanumeric). Never point these at locomo/beam/searchbench/demorecsys.
# EVAL_BRAIN_PREFIX=evaluc

# --- Shared LLM answerer + judge (same model/budget for BrainAPI and hybrid) ---
# DeepSeek (OpenAI-compatible) is the default, matching benchmarks/.env.example.
DEEPSEEK_API_KEY=
EVAL_LLM_BASE_URL=https://api.deepseek.com
EVAL_ANSWER_MODEL=deepseek-v4-flash
EVAL_JUDGE_MODEL=

# Optional OpenAI-compatible override:
# OPENAI_API_KEY=
# EVAL_LLM_BASE_URL=https://api.openai.com/v1
# EVAL_ANSWER_MODEL=gpt-4o-mini
# EVAL_JUDGE_MODEL=gpt-4o
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_BASE_URL=

# Azure judge (optional; falls back to repo-root AZURE_LARGE_LLM_*):
# EVAL_JUDGE_AZURE_ENDPOINT=
# EVAL_JUDGE_AZURE_KEY=
# EVAL_JUDGE_AZURE_API_VERSION=2024-12-01-preview

# --- Hybrid baseline embeddings / reranker (not required for local smoke) ---
# Local smoke uses hashed n-gram dense + lexical reranker (no network).
# For a staging-quality baseline set a real embedding model:
# EVAL_EMBEDDING_PROVIDER=openai
# EVAL_EMBEDDING_API_KEY=
# EVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# EVAL_EMBEDDING_MODEL=text-embedding-3-large
# EVAL_RERANKER=cross-encoder
# EVAL_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Optional future BrainAPI capabilities (ignored on current main) ---
# EVAL_AS_OF_FIELD=as_of
# EVAL_CONFLICT_PATH=/retrieve/conflicts
# EVAL_CONFLICT_PLUGIN=temporal_conflicts

# --- Run layout ---
# EVAL_RUNS_DIR=evals/runs
# EVAL_SCALE=local/small-scale
